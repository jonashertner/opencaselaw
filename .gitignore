__pycache__/
*.pyc
*.egg-info/
*.egg
dist/
build/
.mcpb-build/
*.db
*.sqlite
*.parquet
data/
state/
.env
# Secret env files (chmod-600). NOT covered by the `.env` line above, so without
# this they're untracked-and-not-ignored → publish.py's `git stash -u` stashes +
# restores them as 644 root:root every run, silently re-exposing STRIPE/ANTHROPIC/
# HF secrets and breaking the mcp-user read. Gitignore so the lockdown persists.
.env.*
!.env.example
.vscode/
.idea/
*.DS_Store
output/
logs/
# Scratch/recovery output dirs in the repo root: publish.py runs
# `git stash --include-untracked` during finalization, which sweeps any
# untracked dir here out of the working tree mid-run (it clobbered a live
# EVG recovery on 2026-06-08). Gitignore them so they survive a concurrent
# publish. (The live JSONL shards are safe only because output/ is a symlink
# git won't traverse.) Better still: write recovery output under output/.
recovery_evg/
recovery_*/
benchmarks/latest_search_benchmark.json
!docs/
!docs/**
docs/**/.DS_Store

# Confidential material belongs in the owner-only OpenCaseLaw workspace,
# never in this public repository or its GitHub Pages source tree.
docs/agent-loop/
docs/ops/
docs/letters/
docs/outreach/
docs/drafts/
docs/maintenance-loop-prompt.md
docs/court/dsfa-vorlage.md
docs/court/go-to-market.md
docs/court/isds-konzept-geruest.md
docs/court/pilot-vereinbarung.md
docs/court/preise-lizenz.md
docs/court/technik.md
reply_*.md
reply_*.txt
*.eml
*.msg
*.pst

# Client-specific nginx rules, live configuration copies, and machine-specific
# tunnel helpers are private or host-local operational state.
deploy/nginx-mcp-server.conf
deploy/nginx/bulk-export-throttle.conf
deploy/nginx/opencaselaw-client-denies*.conf
deploy_incapsula_bypass.sh
tools/ne_tunnel.sh
tools/*tunnel*.local.sh
*.bak
*.bak-*
*.backup
*.orig
*.rej
*~
runbooks/zh_arbeitsgericht_yearbooks.md
# generate_feeds.py writes each feed via a sibling .tmp + os.replace. A
# watchdog kill mid-write would leave that .tmp under docs/, and step 6
# `git add docs/feeds` would commit it (docs/** is un-ignored above).
docs/**/*.tmp
docs/GOAL_*.md
scrapers/probe_*
scrapers/scrape_*
# Ad-hoc probe / debug scripts — keep locally but don't clutter git
scripts/probe_*
scripts/debug_zh.py
scripts/debug_search_laws.py
scripts/check_nulls.py
scripts/paper_stats.py
scripts/user_scenario_test.py
scripts/full_function_test.py
scripts/test_be_*.py
web_ui/node_modules/
.venv/
*.png
*.jpeg
# Word add-in icons are part of the deployed asset surface (manifest.xml
# references them as DefaultIconUrl / HighResolutionIconUrl), so the
# blanket *.png ignore would orphan them from the deploy script.
!tools/word-addin/assets/*.png
# docs/static/img/ is the public-static asset surface (served by GH Pages
# under opencaselaw.ch/static/img/) — must be tracked.
!docs/static/img/*.png
# Repository social preview, generated by tools/make_social_preview.py
!docs/assets/*.png
.playwright-mcp/
desktop_extension/
search_stack/finetune_embeddings.py
tools/word-addin/screenshots/

# Coding-agent metadata (per-machine, ephemeral)
.claude/
.superpowers/

# Release artifacts (built locally, not source-of-truth)
artifacts/
docs/paper/v3/opencaselaw-arxiv-*.tar.gz
docs/paper/v3/paper.aux
docs/paper/v3/paper.bbl
docs/paper/v3/paper.blg
docs/paper/v3/paper.log
docs/paper/v3/paper.out
docs/paper/v3/.tectonic-cache/

# Local platform-specific config (hard-coded user paths)
scripts/ne-scraper-local.plist

# Out-of-tree binaries (re-fetch via release tooling, do NOT commit)
tools/mcp-publisher

# Per-launch operational notes that don't belong in source-control
tools/word-addin/partner-center-resubmission-*.txt

# Canonical project docs kept OUT of this public repo on purpose: they hold
# internal operational detail (VPS/proxy/tunnel/disk internals). Loaded locally
# as agent context; gitignored so they can never be committed by accident.
CLAUDE.md
TECHNICAL_OVERVIEW.txt

# Generated at scraper start by deploy/certs/build-ca-bundle.sh (certifi +
# the intermediates in extra/). Never commit the assembled bundle.
deploy/certs/ca-bundle.pem
