# Rate limiting: 30 req/s per IP for API, 10 req/s for SSE connects
limit_req_zone $binary_remote_addr zone=mcp_api:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=mcp_sse:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=mcp_expensive:10m rate=5r/s;

upstream mcp_workers {
    ip_hash;
    server 127.0.0.1:8770;
    server 127.0.0.1:8771;
    server 127.0.0.1:8772;
    server 127.0.0.1:8773;
    server 127.0.0.1:8774;
    server 127.0.0.1:8775;
    server 127.0.0.1:8776;
    server 127.0.0.1:8777;
}

# Stateless REST/SEO traffic uses least_conn. Session transports retain
# ip_hash affinity in the separate upstream above.
upstream mcp_workers_api {
    least_conn;
    server 127.0.0.1:8770;
    server 127.0.0.1:8771;
    server 127.0.0.1:8772;
    server 127.0.0.1:8773;
    server 127.0.0.1:8774;
    server 127.0.0.1:8775;
    server 127.0.0.1:8776;
    server 127.0.0.1:8777;
}

# ── HTTPS (primary) ──────────────────────────────────────────
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name mcp.opencaselaw.ch;

    # Throttled requests return 429 (Too Many Requests), not 503 — a rate-limit
    # is not a server error (2026-07-14: 503s were inflating the 5xx metric).
    limit_req_status 429;

    # Client-specific deny rules are operational data with a short retention
    # window. Keep them in a host-local, unversioned snippet; never commit IPs
    # or behavioural notes to this public disaster-recovery snapshot.
    include /etc/nginx/snippets/opencaselaw-client-denies*.conf;

    # ocl-privacy-analytics: three-tier log split (see docs/datenschutz/)
    access_log /var/log/nginx/tier1.log tier1;
    access_log /var/log/nginx/tier2.log tier2;
    access_log /var/log/nginx/tier3.log tier3;


    ssl_certificate     /etc/letsencrypt/live/mcp.opencaselaw.ch/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp.opencaselaw.ch/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Security headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # CORS for ChatGPT and browser MCP clients
    add_header Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type, Authorization, Mcp-Session-Id, Accept, X-Install-Cohort, X-Client" always;
    add_header Access-Control-Expose-Headers "Mcp-Session-Id" always;
    add_header Access-Control-Allow-Origin "*" always;
    add_header Access-Control-Max-Age 600 always;

    # SSE requires no buffering
    proxy_buffering off;
    proxy_cache off;

    # Long timeouts for SSE connections
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;


    # Block vulnerability probes
    location ~ /\.(env|git|svn|htaccess|DS_Store) { return 444; }
    location ~ ^/(vendor|wp-admin|wp-login|phpmyadmin|v2/) { return 444; }

    location /dev {
        proxy_pass http://mcp_workers_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /metrics {
        proxy_pass http://mcp_workers_api;
    }


    location /health {


        limit_req zone=mcp_api burst=50 nodelay;


        proxy_pass http://mcp_workers_api;


        proxy_http_version 1.1;


        proxy_set_header Host $host;


        proxy_set_header X-Real-IP $remote_addr;


        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;


    }



    # SEO pages: decision pages, sitemaps, robots
    # Redirect old bge_historical URLs to fused bge IDs
    location ~ ^/entscheid/bge_historical_(.+)$ {
        return 301 /entscheid/bge_$1;
    }

    location /entscheid/ {
        proxy_pass http://mcp_workers_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # cli:ch HTTP resolver — redirects /cli/ch/<court>[/<chamber>]/<docket>
    # to the canonical /entscheid/<id>. Bestimmung 01 of Open Law Standards.
    location /cli/ {
        proxy_pass http://mcp_workers_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /sitemap {
        proxy_pass http://mcp_workers_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /robots.txt {
        proxy_pass http://mcp_workers_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /llms.txt {
        proxy_pass http://mcp_workers_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /google-verify {
        proxy_pass http://mcp_workers_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Bulk-access notice served as the body of every 429 in this server
    # block — including the pre-existing mcp_expensive throttles, which
    # until now returned nginx's default page. `internal` keeps it from
    # being fetched directly; `always` keeps the headers on a 4xx.
    error_page 429 /_bulk-access.txt;
    location = /_bulk-access.txt {
        internal;
        root /opt/caselaw/static-notices;
        try_files /bulk-access.txt =404;
        default_type text/plain;
        charset utf-8;
        add_header Link '<https://huggingface.co/datasets/voilaj/swiss-caselaw>; rel="alternate"; title="bulk corpus"' always;
        add_header Retry-After 3600 always;
        add_header X-OpenCaseLaw-Contact "team@jonashertner.com" always;
    }

    # Per-decision export renderers (.pdf/.docx render via reportlab/python-docx
    # on the shared thread pool) are a crawler magnet. robots.txt disallows them
    # (2026-06-25); this is the enforcement floor for bots that ignore robots.
    # Same proxy setup as /api/, but on the 5r/s expensive zone.
    location ~ ^/api/decisions/[^/]+/export {
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "*" always;
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Authorization, Mcp-Session-Id, Accept, X-Install-Cohort, X-Client, X-OCL-Key" always;
            add_header Access-Control-Max-Age 600 always;
            add_header Content-Length 0 always;
            return 204;
        }
        # Tell every bulk consumer where the one-download mirror is. The
        # detailed calibration evidence is retained in the private operations
        # workspace, not in this public configuration snapshot.
        add_header Link '<https://huggingface.co/datasets/voilaj/swiss-caselaw>; rel="alternate"; title="bulk corpus"' always;
        add_header X-OpenCaseLaw-Bulk "Full CC0 corpus in one download at the Link header. High-volume or commercial use: team@jonashertner.com" always;
        limit_req zone=ocl_export burst=30 nodelay;
        limit_req zone=mcp_expensive burst=5 nodelay;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Expose-Headers;
        proxy_hide_header Access-Control-Max-Age;
        proxy_pass http://mcp_workers_api;
        # Fail fast on the API: nothing legitimate on /api runs 60s+ now that
        # queries are bounded server-side; hanging connectors got 86400s before.
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Tighter quota for LLM-backed expensive endpoints.
    # See docs/fair-use.html.
    location ~ ^/api/(attest|verify-claim|mock-decision|exam-question|trends|doctrine)(/|$|\?) {
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "*" always;
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Authorization, Mcp-Session-Id, Accept, X-Install-Cohort, X-Client, X-OCL-Key" always;
            add_header Access-Control-Max-Age 600 always;
            add_header Content-Length 0 always;
            return 204;
        }
        limit_req zone=mcp_expensive burst=10 nodelay;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Expose-Headers;
        proxy_hide_header Access-Control-Max-Age;
        proxy_pass http://mcp_workers_api;
        # Fail fast on the API: nothing legitimate on /api runs 60s+ now that
        # queries are bounded server-side; hanging connectors got 86400s before.
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/ {
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "*" always;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Authorization, Mcp-Session-Id, Accept, X-Install-Cohort, X-Client" always;
            add_header Access-Control-Max-Age 600 always;
            add_header Content-Length 0 always;
            return 204;
        }
        limit_req zone=mcp_api burst=50 nodelay;
        # Strip CORS headers emitted by the FastAPI backend so nginx is
        # the single source of CORS. Without this, browsers see two
        # `Access-Control-Allow-Origin` values and reject the response
        # (issue first hit by the Word add-in on 2026-04-22).
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Expose-Headers;
        proxy_hide_header Access-Control-Max-Age;
        proxy_pass http://mcp_workers_api;
        # Fail fast on the API: nothing legitimate on /api runs 60s+ now that
        # queries are bounded server-side; hanging connectors got 86400s before.
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # SSE at / and /sse (both serve the same endpoint)
    location = / {
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "*" always;
        limit_req zone=mcp_sse burst=50 nodelay;
        proxy_pass http://mcp_workers;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_set_header Cache-Control no-cache;
        proxy_set_header X-Accel-Buffering no;
    }

    location /sse {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Authorization, Mcp-Session-Id, Accept, X-Install-Cohort, X-Client" always;
            add_header Access-Control-Max-Age 600 always;
            add_header Content-Length 0 always;
            return 204;
        }
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "*" always;
        limit_req zone=mcp_sse burst=50 nodelay;
        proxy_pass http://mcp_workers;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_set_header Cache-Control no-cache;
        proxy_set_header X-Accel-Buffering no;
    }
    location /mcp {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Authorization, Mcp-Session-Id, Accept, X-Install-Cohort, X-Client" always;
            add_header Access-Control-Max-Age 600 always;
            add_header Content-Length 0 always;
            return 204;
        }
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "*" always;
        limit_req zone=mcp_sse burst=50 nodelay;
        proxy_pass http://mcp_workers;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_set_header Cache-Control no-cache;
        proxy_set_header X-Accel-Buffering no;
        proxy_read_timeout 120s;
    }

    location /messages/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Authorization, Mcp-Session-Id, Accept, X-Install-Cohort, X-Client" always;
            add_header Access-Control-Max-Age 600 always;
            add_header Content-Length 0 always;
            return 204;
        }
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "*" always;
        limit_req zone=mcp_api burst=50 nodelay;
        proxy_pass http://mcp_workers;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
    }

    # Site-content paths live on opencaselaw.ch (GitHub Pages), not on the
    # MCP host. Bots (Googlebot, AmazonBot etc.) discovered these URLs
    # somewhere and are hitting the wrong host — without these rewrites
    # they get 404 from the nginx default-root, and the SEO equity is
    # wasted. 301-redirect them so crawlers consolidate on the canonical
    # host. /entscheide/ (plural) is the static index page; the MCP host
    # serves only /entscheid/{id} (singular), so no conflict.
    location ~ ^/(laws|courts|search|word|paper|coverage|ueber|entscheide|gesetze)(/|$) {
        return 301 https://opencaselaw.ch$request_uri;
    }
    location = /quality.html {
        return 301 https://opencaselaw.ch$request_uri;
    }
}

# ── HTTP → HTTPS redirect ────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name mcp.opencaselaw.ch;
    # ocl-privacy-analytics: log redirect hits via tier2 as well
    access_log /var/log/nginx/tier1.log tier1;
    access_log /var/log/nginx/tier2.log tier2;
    access_log /var/log/nginx/tier3.log tier3;

    return 301 https://$host$request_uri;
}

# ── Legacy port 8765 (retired; returns 410 only) ───────────────
server {
    # The former cleartext compatibility listener is intentionally inert.
    # Nothing is proxied; callers receive an actionable TLS migration notice.
    listen 8765;
    listen [::]:8765;

    access_log /var/log/nginx/legacy8765.log legacy8765;

    location / {
        default_type text/plain;
        add_header Link "<https://mcp.opencaselaw.ch>; rel=\"successor-version\"" always;
        add_header X-OpenCaseLaw-Contact "team@jonashertner.com" always;
        return 410 "Gone. This cleartext port is retired: it carried MCP traffic without TLS.\nUse https://mcp.opencaselaw.ch (port 443) - same endpoint, same tools.\nSee https://opencaselaw.ch/#connect\n";
    }
}
