  "person": "acc",
  "name": "Prof. Dr. Thomas Bärtschi",
  "role": "Chair of the Audit Committee"
 },
 "restrictions": [
  "Immediate termination right if the borrower's credit deteriorates",
  "Annual review of the interest rate against the ESTV safe-harbour rate",
  "Loan amount treated as blocked free equity"
 ],
