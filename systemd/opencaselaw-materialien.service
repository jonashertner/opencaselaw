[Unit]
Description=OpenCaseLaw daily verbatim Botschaft ingest (delta from amendment_refs)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/caselaw/repo
# --discover-via-sparql is the canonical candidate source as of v0.5:
# query Fedlex for every FGA URI of the --types resource types in each
# language, dedup against botschaft_documents, ingest the delta. We
# loop DE → FR → IT so all three multilingual versions stay in sync;
# materialien.db is single-writer (journal_mode=delete) so they must
# run sequentially. Steady-state delta is a handful per language.
# amendment_refs (v0.2/v0.3 source) is dropped because it indexes
# Bundesbeschlüsse + Mitteilungen rather than the Botschaften.
# --types (2026-09-09): besides 23 Botschaft, the Bundesblatt Materialien
# on Fedlex's own file store — 24 Bericht des Bundesrates, 25 Stellungnahme
# des Bundesrates, 30 Bericht parlamentarische Kommission, 38 Erlassentwurf,
# 39 Vorentwurf Erlass (currently 0 works), 40 Eröffnung des Vernehmlassungs-
# verfahrens — ~3,500 documents per language on the first run (~3-10 h at
# the measured 0.3-0.9 docs/s), a handful per night afterwards. Each row is
# tagged botschaft_documents.doc_type. A run cut by TimeoutStartSec resumes
# where it stopped (every document commits on its own). Files hosted on
# amtsdruckschriften.bar.admin.ch are skipped here by design.
# Fetch policy (2026-09-09): --max-per-run 1500 bounds each language run to
# ~30-80 min at the measured rate (the catch-up takes three nights instead
# of one); the loop stops with exit 4 on the first HTTP 429/403 or after
# five consecutive failures, backing off exponentially before that, so the
# && chain halts and FR/IT plus the enrichment wait for the next night.
# The 0.5 s rate stays: the files come from Fedlex's own store.
ExecStart=/bin/bash -c '\
    /usr/bin/python3 -m search_stack.build_botschaft_corpus \
        --ingest-all --discover-via-sparql --language de --min-year 1900 \
        --types 23,24,25,30,38,39,40 --max-per-run 1500 \
        --rate-limit 0.5 --db /opt/caselaw/repo/output/materialien.db && \
    /usr/bin/python3 -m search_stack.build_botschaft_corpus \
        --ingest-all --discover-via-sparql --language fr --min-year 1900 \
        --types 23,24,25,30,38,39,40 --max-per-run 1500 \
        --rate-limit 0.5 --db /opt/caselaw/repo/output/materialien.db && \
    /usr/bin/python3 -m search_stack.build_botschaft_corpus \
        --ingest-all --discover-via-sparql --language it --min-year 1900 \
        --types 23,24,25,30,38,39,40 --max-per-run 1500 \
        --rate-limit 0.5 --db /opt/caselaw/repo/output/materialien.db && \
    /usr/bin/python3 /opt/caselaw/repo/scripts/enrich_botschaft_links.py \
        --types 23,24,25,30,38,39,40 \
        --db /opt/caselaw/repo/output/materialien.db \
        --statutes /opt/caselaw/repo/output/statutes.db'
# 12 hours: 3-language bulk catch-up may take a few hours on first
# run; steady-state delta finishes in minutes.
TimeoutStartSec=43200
StandardOutput=append:/opt/caselaw/repo/logs/materialien_ingest.log
StandardError=append:/opt/caselaw/repo/logs/materialien_ingest.log
