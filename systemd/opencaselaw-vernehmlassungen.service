[Unit]
Description=OpenCaseLaw Vernehmlassungen from Fedlex (Erläuternde Berichte, Vorlagen, Ergebnisberichte, Stellungnahmen) → consultations.db
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/caselaw/repo
Environment=PYTHONPATH=/opt/caselaw/repo
# Never alongside the full build (03:30 UTC, ~13-14 h): the fetch is light,
# but the publish snapshot writes the whole corpus (several GB) and would
# compete with the build for the page cache. A skipped run is harmless; the
# timer fires twice a day.
# The full build is a oneshot: while it runs, `systemctl is-active` says
# "activating", not "active" — a guard testing for "active" alone let the
# 2026-10-20 17:45 run start mid-build. Any non-idle state skips the run.
ExecCondition=/bin/sh -c 'for u in opencaselaw-publish.service; do case "$$(systemctl is-active $$u)" in active|activating|deactivating|reloading|refreshing) exit 1;; esac; done; exit 0'
Nice=10
CPUWeight=20
IOWeight=20
# discover (all years, ~2 min of SPARQL) → fetch (Fedlex file store, one
# connection, 0.5 s between requests, stops on 429/403 or 5 failures in a
# row, 3 h budget per run; the first catch-up of ~28,700 files takes a few
# runs, then a handful per day) → publish (VACUUM INTO + os.replace onto the
# volume, only when something changed or weekly). The work DB is the
# resumable state and is never served.
ExecStart=/usr/bin/python3 -m search_stack.build_consultation_corpus run \
    --work-db /mnt/HC_Volume_104655575/output/consultations_work.db \
    --out /mnt/HC_Volume_104655575/output/consultations.db \
    --rate-limit 0.5 --max-seconds 10800
# OCR in slices (2026-10-21): one hour per run of the scanned pages still
# without text — whole files first, then the empty pages inside files that
# have text (scanned submissions in Stellungnahmen collections, ~53k pages in
# total). Lowest CPU priority, two Tesseract processes; every file commits on
# its own, a cut file starts again next time. Its text goes live with the
# next run's publish. --no-unit-check: this IS the unit the check guards.
ExecStartPost=-/usr/bin/nice -n 19 /usr/bin/python3 -m search_stack.build_consultation_corpus ocr \
    --work-db /mnt/HC_Volume_104655575/output/consultations_work.db \
    --scope no_text,partial --max-seconds 3600 --workers 2 --no-unit-check
# The nightly completeness report (Bundesblatt typed + historical +
# Vernehmlassungen vs a fresh Fedlex census) and one ntfy push on a gap.
# "-": a gap is reported, not a failed unit.
ExecStartPost=-/usr/bin/python3 /opt/caselaw/repo/scripts/check_materialien_completeness.py \
    --materialien-db /opt/caselaw/repo/output/materialien.db \
    --consultations-db /mnt/HC_Volume_104655575/output/consultations.db \
    --report /opt/caselaw/repo/logs/materialien_completeness.json
TimeoutStartSec=5h30min
StandardOutput=append:/opt/caselaw/repo/logs/vernehmlassungen.log
StandardError=append:/opt/caselaw/repo/logs/vernehmlassungen.log
