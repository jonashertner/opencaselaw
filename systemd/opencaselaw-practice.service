[Unit]
Description=OpenCaseLaw federal Verwaltungspraxis scrape (ESTV, SEM, BAFU, SECO, FINMA, BAG, BJ; BSV once promoted)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/caselaw/repo
Environment=PYTHONPATH=/opt/caselaw/repo
# schkg_kantone: ne.ch, jura.ch and ti.ch block the server's IP range; same tunnel as the court scrapers.
Environment=NE_PROXY=socks5h://127.0.0.1:1080
Environment=JU_PROXY=socks5h://127.0.0.1:1080
Environment=TI_PROXY=socks5h://127.0.0.1:1080
ExecStart=/usr/bin/python3 -m scrapers.practice.runner
ExecStartPost=/usr/bin/python3 -m search_stack.build_practice_db --jsonl-dir /opt/caselaw/repo/output/practice --db /opt/caselaw/repo/output/practice.db
# Rolling, health-gated, discovers ALL workers (was: simultaneous restart of
# 8770-8773 only — Saturday-morning downtime + stale practice.db on 8774-8777).
ExecStartPost=/usr/bin/bash /opt/caselaw/repo/scripts/rolling_restart_workers.sh
# No timeout: a re-issue-heavy week (or BSV, once promoted) can exceed an hour,
# and a SIGTERM mid-ExecStart skips the rebuild + rolling restart for EVERY
# source. The runner is idempotent (append-only JSONL, doc_id dedup).
TimeoutStartSec=infinity
StandardOutput=append:/opt/caselaw/repo/logs/practice_scrape.log
StandardError=append:/opt/caselaw/repo/logs/practice_scrape.log
